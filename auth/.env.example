# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# URL where the auth server is reachable (used for OAuth callback URLs)
BETTER_AUTH_URL=http://localhost:3001

# GitLab OAuth app credentials
# Create at: https://gitlab.com/-/profile/applications
# Redirect URI: http://localhost:5173/api/auth/callback/gitlab
GITLAB_CLIENT_ID=your-gitlab-app-client-id
GITLAB_CLIENT_SECRET=your-gitlab-app-client-secret

# GitLab group path or numeric ID whose members get admin access
GITLAB_GROUP=your-group/path

# For self-hosted GitLab, uncomment and set:
# GITLAB_URL=https://gitlab.example.com

# Optional overrides
# FRONTEND_URL=http://localhost:5173
# AUTH_PORT=3001
